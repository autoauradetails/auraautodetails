<section
    class="booking"
    id="booking"
>

    <div class="container">


        <div class="booking-layout">


            <!-- BOOKING INFORMATION -->

            <div class="booking-copy">

                <div class="eyebrow">
                    Online Booking
                </div>

                <h2>
                    GET YOUR CAR LOOKING
                    <span>DIFFERENT.</span>
                </h2>

                <p>

                    Choose your service, tell us about your vehicle,
                    and request your preferred date.

                    We'll contact you to confirm availability
                    and final pricing.

                </p>


                <div class="contact-box">

                    <small>
                        Call or Text
                    </small>

                    <strong>

                        <a href="tel:4703343089">
                            470-334-3089
                        </a>

                    </strong>

                </div>


                <div class="contact-box">

                    <small>
                        Service Area
                    </small>

                    <strong>
                        Cartersville • White • Canton • Rome
                    </strong>

                </div>


                <div class="contact-box">

                    <small>
                        Starting Price
                    </small>

                    <strong>
                        $95+
                    </strong>

                </div>

            </div>


            <!-- BOOKING CARD -->

            <div class="booking-card">


                <div class="progress">

                    <span class="active"></span>

                    <span></span>

                    <span></span>

                    <span></span>

                </div>


                <!-- STEP 1 -->

                <div
                    class="step active"
                    id="step1"
                >

                    <div class="step-title">
                        Choose Your Detail
                    </div>

                    <div class="step-subtitle">
                        Select the package you want.
                    </div>


                    <div class="package-select">


                        <button
                            type="button"
                            class="package-option selected"
                            data-name="Express Exterior"
                            data-price="95"
                        >

                            <strong>
                                Express Exterior
                            </strong>

                            <small>
                                Exterior refresh
                            </small>

                            <b>
                                $95+
                            </b>

                        </button>


                        <button
                            type="button"
                            class="package-option"
                            data-name="Full Interior"
                            data-price="125"
                        >

                            <strong>
                                Full Interior
                            </strong>

                            <small>
                                Interior deep clean
                            </small>

                            <b>
                                $125+
                            </b>

                        </button>


                        <button
                            type="button"
                            class="package-option"
                            data-name="Full Detail"
                            data-price="195"
                        >

                            <strong>
                                Full Detail
                            </strong>

                            <small>
                                Most popular
                            </small>

                            <b>
                                $195+
                            </b>

                        </button>


                        <button
                            type="button"
                            class="package-option"
                            data-name="Premium Detail"
                            data-price="275"
                        >

                            <strong>
                                Premium Detail
                            </strong>

                            <small>
                                Maximum finish
                            </small>

                            <b>
                                $275+
                            </b>

                        </button>


                    </div>


                    <div class="step-buttons">

                        <span></span>

                        <button
                            type="button"
                            class="btn primary"
                            onclick="nextStep()"
                        >
                            Continue →
                        </button>

                    </div>

                </div>


                <!-- STEP 2 -->

                <div
                    class="step"
                    id="step2"
                >

                    <div class="step-title">
                        Vehicle Information
                    </div>

                    <div class="step-subtitle">
                        Tell us about your vehicle.
                    </div>


                    <div class="form-grid">


                        <div class="field">

                            <label>
                                Full Name
                            </label>

                            <input
                                id="name"
                                type="text"
                                autocomplete="name"
                                placeholder="Your name"
                            >

                        </div>


                        <div class="field">

                            <label>
                                Phone
                            </label>

                            <input
                                id="phone"
                                type="tel"
                                autocomplete="tel"
                                placeholder="470-555-5555"
                            >

                        </div>


                    </div>


                    <div class="form-grid">


                        <div class="field">

                            <label>
                                Vehicle
                            </label>

                            <input
                                id="vehicle"
                                type="text"
                                placeholder="2024 BMW M4"
                            >

                        </div>


                        <div class="field">

                            <label>
                                Vehicle Size
                            </label>

                            <select id="size">

                                <option>
                                    Sedan / Coupe
                                </option>

                                <option>
                                    Small SUV / Crossover
                                </option>

                                <option>
                                    Large SUV / Truck
                                </option>

                                <option>
                                    3-Row SUV
                                </option>

                            </select>

                        </div>


                    </div>


                    <div class="field">

                        <label>
                            Vehicle Condition / Notes
                        </label>

                        <textarea
                            id="notes"
                            placeholder="Pet hair, stains, mud, heavy dirt, etc."
                        ></textarea>

                    </div>


                    <div class="step-buttons">

                        <button
                            type="button"
                            class="btn outline"
                            onclick="previousStep()"
                        >
                            ← Back
                        </button>


                        <button
                            type="button"
                            class="btn primary"
                            onclick="nextStep()"
                        >
                            Continue →
                        </button>

                    </div>

                </div>


                <!-- STEP 3 -->

                <div
                    class="step"
                    id="step3"
                >

                    <div class="step-title">
                        Preferred Date
                    </div>

                    <div class="step-subtitle">
                        Tell us when you'd like your detail.
                    </div>


                    <div class="form-grid">


                        <div class="field">

                            <label>
                                Preferred Date
                            </label>

                            <input
                                id="date"
                                type="date"
                            >

                        </div>


                        <div class="field">

                            <label>
                                Preferred Time
                            </label>

                            <select id="time">

                                <option>
                                    Morning
                                </option>

                                <option>
                                    Midday
                                </option>

                                <option>
                                    Afternoon
                                </option>

                                <option>
                                    Evening
                                </option>

                            </select>

                        </div>


                    </div>


                    <div class="field">

                        <label>
                            Service Location
                        </label>

                        <input
                            id="location"
                            type="text"
                            autocomplete="street-address"
                            placeholder="City / area"
                        >

                    </div>


                    <div class="field">

                        <label>
                            Additional Notes
                        </label>

                        <textarea
                            id="finalNotes"
                            placeholder="Anything else we should know?"
                        ></textarea>

                    </div>


                    <div class="step-buttons">

                        <button
                            type="button"
                            class="btn outline"
                            onclick="previousStep()"
                        >
                            ← Back
                        </button>


                        <button
                            type="button"
                            class="btn primary"
                            onclick="nextStep()"
                        >
                            Review →
                        </button>

                    </div>

                </div>


                <!-- STEP 4 -->

                <div
                    class="step"
                    id="step4"
                >

                    <div class="step-title">
                        Review Your Request
                    </div>

                    <div class="step-subtitle">
                        Make sure everything looks correct.
                    </div>


                    <div class="summary">


                        <div class="summary-row">

                            <span>
                                Service
                            </span>

                            <strong id="summaryService">
                                Express Exterior
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                Starting Price
                            </span>

                            <strong id="summaryPrice">
                                $95+
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                Vehicle
                            </span>

                            <strong id="summaryVehicle">
                                —
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                Date
                            </span>

                            <strong id="summaryDate">
                                —
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                Location
                            </span>

                            <strong id="summaryLocation">
                                —
                            </strong>

                        </div>


                    </div>


                    <div class="step-buttons">

                        <button
                            type="button"
                            class="btn outline"
                            onclick="previousStep()"
                        >
                            ← Back
                        </button>


                        <button
                            type="button"
                            class="btn primary"
                            onclick="submitBooking()"
                        >
                            Request Quote →
                        </button>

                    </div>

                </div>


            </div>

        </div>

    </div>

</section>


<!-- =======================================================
     FAQ
======================================================= -->

<section id="faq">

    <div class="container">


        <div class="section-header">

            <div class="eyebrow">
                FAQ
            </div>

            <h2>
                Questions?
                <span>Answered.</span>
            </h2>

        </div>


        <div class="faq">


            <details>

                <summary>
                    How much does a detail cost?
                </summary>

                <p>
                    Services start at $95. Final pricing depends
                    on vehicle size and condition.
                </p>

            </details>


            <details>

                <summary>
                    Do you come to me?
                </summary>

                <p>
                    AURA is built around mobile detailing and can
                    service customers at locations where the setup allows.
                </p>

            </details>


            <details>

                <summary>
                    What areas do you serve?
                </summary>

                <p>
                    Primary service areas include Cartersville,
                    White, Canton, Rome and surrounding areas.
                </p>

            </details>


            <details>

                <summary>
                    Why do you ask about vehicle condition?
                </summary>

                <p>
                    Vehicle condition can affect the amount of work
                    required and therefore the final quote.
                </p>

            </details>


            <details>

                <summary>
                    Is my appointment automatically confirmed?
                </summary>

                <p>
                    No. This form submits a booking request.
                    AURA will contact you to confirm availability,
                    location and final pricing.
                </p>

            </details>


        </div>

    </div>

</section>


<!-- =======================================================
     FOOTER
======================================================= -->

<footer>

    <div class="footer">


        <div>

            <div class="footer-logo">
                AURA
                <span>AUTO DETAILS</span>
            </div>

            <small>
                Premium mobile auto detailing.
            </small>

        </div>


        <div class="footer-contact">

            <a href="tel:4703343089">
                470-334-3089
            </a>

            <br>

            Cartersville • White • Canton • Rome

        </div>


    </div>

</footer>


<script>

/* =========================================================
   MOBILE MENU
========================================================= */

const menuToggle =
    document.getElementById("menuToggle");

const mobileMenu =
    document.getElementById("mobileMenu");


menuToggle.addEventListener(
    "click",
    function() {

        const isOpen =
            mobileMenu.classList.toggle("open");

        menuToggle.classList.toggle(
            "active",
            isOpen
        );

        menuToggle.setAttribute(
            "aria-expanded",
            isOpen
        );

    }
);


/* CLOSE MOBILE MENU AFTER CLICKING */

document
    .querySelectorAll(".mobile-menu a")
    .forEach(link => {

        link.addEventListener(
            "click",
            () => {

                mobileMenu.classList.remove("open");

                menuToggle.classList.remove("active");

                menuToggle.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }
        );

    });


/* =========================================================
   BEFORE / AFTER GALLERY
========================================================= */

const galleryTrack =
    document.getElementById("galleryTrack");

const galleryDots =
    document.querySelectorAll(".gallery-dot");

const galleryPrev =
    document.querySelector(".gallery-prev");

const galleryNext =
    document.querySelector(".gallery-next");

let galleryIndex = 0;

const galleryTotal =
    document.querySelectorAll(".gallery-slide").length;


/* UPDATE GALLERY */

function updateGallery() {

    galleryTrack.style.transform =
        `translateX(-${galleryIndex * 100}%)`;


    galleryDots.forEach(
        (dot, index) => {

            dot.classList.toggle(
                "active",
                index === galleryIndex
            );

        }
    );

}


/* NEXT */

galleryNext.addEventListener(
    "click",
    () => {

        galleryIndex++;

        if(
            galleryIndex >= galleryTotal
        ) {

            galleryIndex = 0;

        }

        updateGallery();

    }
);


/* PREVIOUS */

galleryPrev.addEventListener(
    "click",
    () => {

        galleryIndex--;

        if(
            galleryIndex < 0
        ) {

            galleryIndex =
                galleryTotal - 1;

        }

        updateGallery();

    }
);


/* DOTS */

galleryDots.forEach(
    (dot, index) => {

        dot.addEventListener(
            "click",
            () => {

                galleryIndex = index;

                updateGallery();

            }
        );

    }
);


/* =========================================================
   MOBILE SWIPE
========================================================= */

let galleryTouchStart = 0;

let galleryTouchEnd = 0;


galleryTrack.addEventListener(
    "touchstart",
    event => {

        galleryTouchStart =
            event.changedTouches[0].screenX;

    },
    {
        passive: true
    }
);


galleryTrack.addEventListener(
    "touchend",
    event => {

        galleryTouchEnd =
            event.changedTouches[0].screenX;


        const difference =
            galleryTouchStart -
            galleryTouchEnd;


        if(
            Math.abs(difference) < 50
        ) {

            return;

        }


        if(
            difference > 0
        ) {

            galleryNext.click();

        } else {

            galleryPrev.click();

        }

    },
    {
        passive: true
    }
);


/* =========================================================
   BOOKING SYSTEM
========================================================= */

let currentStep = 1;

let selectedService =
    "Express Exterior";

let selectedPrice = 95;


/* =========================================================
   SERVICE SELECTION
========================================================= */

document
    .querySelectorAll(".package-option")
    .forEach(button => {

        button.addEventListener(
            "click",
            () => {

                document
                    .querySelectorAll(
                        ".package-option"
                    )
                    .forEach(btn =>
                        btn.classList.remove(
                            "selected"
                        )
                    );


                button.classList.add(
                    "selected"
                );


                selectedService =
                    button.dataset.name;


                selectedPrice =
                    button.dataset.price;

            }
        );

    });


/* =========================================================
   NEXT STEP
========================================================= */

function nextStep() {


    /* STEP 2 VALIDATION */

    if(
        currentStep === 2
    ) {

        const name =
            document.getElementById("name");

        const phone =
            document.getElementById("phone");

        const vehicle =
            document.getElementById("vehicle");


        if(
            !name.value.trim() ||
            !phone.value.trim() ||
            !vehicle.value.trim()
        ) {

            alert(
                "Please fill out your name, phone number, and vehicle."
            );

            return;

        }

    }


    /* STEP 3 VALIDATION */

    if(
        currentStep === 3
    ) {

        const date =
            document.getElementById("date");

        const location =
            document.getElementById("location");


        if(
            !date.value ||
            !location.value.trim()
        ) {

            alert(
                "Please choose a date and service location."
            );

            return;

        }

    }


    if(
        currentStep < 4
    ) {

        currentStep++;

        updateSteps();

    }

}


/* =========================================================
   PREVIOUS STEP
========================================================= */

function previousStep() {

    if(
        currentStep > 1
    ) {

        currentStep--;

        updateSteps();

    }

}


/* =========================================================
   UPDATE STEPS
========================================================= */

function updateSteps() {


    document
        .querySelectorAll(".step")
        .forEach(step => {

            step.classList.remove(
                "active"
            );

        });


    document
        .getElementById(
            "step" + currentStep
        )
        .classList.add(
            "active"
        );


    document
        .querySelectorAll(
            ".progress span"
        )
        .forEach(
            (bar, index) => {

                bar.classList.toggle(
                    "active",
                    index < currentStep
                );

            }
        );


    updateSummary();


    /* MOBILE SCROLL */

    if(
        window.innerWidth <= 700
    ) {

        document
            .querySelector(".booking-card")
            .scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

    }

}


/* =========================================================
   SUMMARY
========================================================= */

function updateSummary() {


    document.getElementById(
        "summaryService"
    ).textContent =
        selectedService;


    document.getElementById(
        "summaryPrice"
    ).textContent =
        "$" + selectedPrice + "+";


    const vehicle =
        document.getElementById(
            "vehicle"
        );

    const date =
        document.getElementById(
            "date"
        );

    const location =
        document.getElementById(
            "location"
        );


    if(vehicle) {

        document.getElementById(
            "summaryVehicle"
        ).textContent =
            vehicle.value || "—";

    }


    if(date) {

        document.getElementById(
            "summaryDate"
        ).textContent =
            date.value || "—";

    }


    if(location) {

        document.getElementById(
            "summaryLocation"
        ).textContent =
            location.value || "—";

    }

}


/* =========================================================
   SUBMIT BOOKING
========================================================= */

function submitBooking() {


    const name =
        document.getElementById(
            "name"
        ).value;

    const phone =
        document.getElementById(
            "phone"
        ).value;

    const vehicle =
        document.getElementById(
            "vehicle"
        ).value;

    const size =
        document.getElementById(
            "size"
        ).value;

    const date =
        document.getElementById(
            "date"
        ).value;

    const time =
        document.getElementById(
            "time"
        ).value;

    const location =
        document.getElementById(
            "location"
        ).value;

    const notes =
        document.getElementById(
            "notes"
        ).value;

    const finalNotes =
        document.getElementById(
            "finalNotes"
        ).value;


    const message =

`AURA AUTO DETAILS — BOOKING REQUEST

Name: ${name}

Phone: ${phone}

Vehicle: ${vehicle}

Vehicle Size: ${size}

Service: ${selectedService}

Starting Price: $${selectedPrice}+

Preferred Date: ${date}

Preferred Time: ${time}

Location: ${location}

Vehicle Notes:
${notes || "None"}

Additional Notes:
${finalNotes || "None"}

Please confirm availability and final pricing.`;


    window.location.href =
        "sms:4703343089?body=" +
        encodeURIComponent(message);

}


/* =========================================================
   MINIMUM BOOKING DATE
========================================================= */

const today =
    new Date();


today.setMinutes(
    today.getMinutes()
    -
    today.getTimezoneOffset()
);


document.getElementById(
    "date"
).min =
    today
        .toISOString()
        .split("T")[0];


</script>


</body>
</html>
