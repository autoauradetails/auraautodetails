<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AURA Auto Details | Premium Mobile Detailing</title>

<style>

/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --black: #030405;
    --dark: #080b0f;
    --card: #0d1116;
    --blue: #008cff;
    --blue-light: #32b4ff;
    --gold: #f4c542;
    --white: #ffffff;
    --gray: #9da5ae;
    --border: rgba(255,255,255,.1);
}

html {
    scroll-behavior: smooth;
    overflow-x: hidden;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--black);
    color: white;
    overflow-x: hidden;
    width: 100%;
}

button,
input,
select,
textarea {
    font-family: inherit;
}


/* =========================================================
   NAVIGATION
========================================================= */

nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;

    background: rgba(3,4,5,.88);
    backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(0,140,255,.25);
}

.nav-container {
    max-width: 1250px;
    margin: auto;

    padding: 16px 25px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: white;
    text-decoration: none;

    font-size: 26px;
    font-weight: 950;
    letter-spacing: 5px;
}

.logo span {
    display: block;

    font-size: 9px;
    letter-spacing: 4px;

    color: var(--blue);

    margin-top: 3px;
}

.nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
}

.nav-links a {
    color: #ddd;
    text-decoration: none;

    font-size: 13px;

    transition: .2s;
}

.nav-links a:hover {
    color: var(--blue);
}

.book-button {
    background: linear-gradient(
        135deg,
        #159cff,
        #006fe6
    );

    padding: 11px 18px;

    border-radius: 7px;

    color: white !important;

    font-weight: 900;
}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.menu-toggle {
    display: none;

    width: 44px;
    height: 44px;

    border: 1px solid rgba(255,255,255,.15);
    border-radius: 8px;

    background: rgba(255,255,255,.03);

    cursor: pointer;

    align-items: center;
    justify-content: center;

    flex-direction: column;

    gap: 5px;
}

.menu-toggle span {
    display: block;

    width: 20px;
    height: 2px;

    background: white;

    border-radius: 10px;

    transition: .25s;
}

.menu-toggle.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
}

.menu-toggle.active span:nth-child(2) {
    opacity: 0;
}

.menu-toggle.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
}


/* =========================================================
   MOBILE MENU
========================================================= */

.mobile-menu {
    display: none;

    position: fixed;

    top: 65px;
    left: 0;

    width: 100%;

    background: rgba(3,4,5,.97);

    backdrop-filter: blur(20px);

    border-bottom: 1px solid rgba(0,140,255,.25);

    padding: 10px 16px 18px;

    z-index: 999;
}

.mobile-menu.open {
    display: block;
}

.mobile-menu a {
    display: block;

    padding: 15px 10px;

    color: #ddd;

    text-decoration: none;

    font-size: 14px;

    font-weight: 700;

    border-bottom: 1px solid rgba(255,255,255,.06);
}

.mobile-menu a:last-child {
    border-bottom: none;
}

.mobile-menu a:hover {
    color: var(--blue);
}

.mobile-menu .mobile-book {
    margin-top: 10px;

    text-align: center;

    background: linear-gradient(
        135deg,
        #159cff,
        #006fe6
    );

    border-radius: 8px;

    color: white;
}


/* =========================================================
   TOP SPACE
========================================================= */

.top-space {
    height: 67px;

    position: relative;

    overflow: hidden;

    background:
        radial-gradient(
            ellipse at center,
            rgba(0,140,255,.08),
            transparent 65%
        );

    border-bottom:
        1px solid rgba(0,140,255,.15);
}

.top-space::after {
    content: "";

    position: absolute;

    bottom: 0;
    left: 0;

    width: 100%;
    height: 1px;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(0,140,255,.7),
            transparent
        );

    box-shadow:
        0 0 18px rgba(0,140,255,.7);
}


/* =========================================================
   GENERAL
========================================================= */

.container {
    width: 100%;
    max-width: 1250px;

    margin: auto;

    position: relative;
    z-index: 2;
}

section {
    padding: 90px 25px;
}


/* =========================================================
   HERO
========================================================= */

.hero {
    min-height: 610px;

    display: flex;
    align-items: center;

    padding: 90px 25px;

    position: relative;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 85% 35%,
            rgba(0,140,255,.15),
            transparent 30%
        ),
        radial-gradient(
            circle at 10% 90%,
            rgba(0,90,255,.06),
            transparent 35%
        ),
        #030405;
}

.hero::before {
    content: "";

    position: absolute;

    width: 500px;
    height: 500px;

    right: -250px;
    top: 50%;

    transform: translateY(-50%);

    border-radius: 50%;

    border: 1px solid rgba(0,140,255,.08);

    box-shadow:
        0 0 100px rgba(0,140,255,.05);
}

.hero-content {
    max-width: 820px;
}

.eyebrow {
    color: var(--blue);

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 5px;

    text-transform: uppercase;

    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(52px,7vw,90px);

    line-height: .92;

    letter-spacing: -4px;

    font-weight: 950;
}

.hero h1 span {
    color: var(--blue);

    text-shadow:
        0 0 30px rgba(0,140,255,.2);
}

.hero-description {
    max-width: 650px;

    margin-top: 27px;
    margin-bottom: 32px;

    color: var(--gray);

    font-size: 18px;

    line-height: 1.6;
}

.buttons {
    display: flex;

    gap: 13px;

    flex-wrap: wrap;
}

.btn {
    padding: 14px 23px;

    border-radius: 8px;

    font-weight: 900;

    text-decoration: none;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    border: none;

    transition: .25s;
}

.primary {
    background:
        linear-gradient(
            135deg,
            #159cff,
            #006fe6
        );

    color: white;

    box-shadow:
        0 0 25px rgba(0,140,255,.18);
}

.primary:hover {
    transform: translateY(-3px);

    box-shadow:
        0 0 35px rgba(0,140,255,.4);
}

.outline {
    border: 1px solid #333;

    color: white;

    background: rgba(255,255,255,.02);
}

.outline:hover {
    border-color: var(--blue);

    color: var(--blue);
}

.stats {
    display: flex;

    gap: 45px;

    margin-top: 48px;

    flex-wrap: wrap;
}

.stat strong {
    display: block;

    font-size: 25px;
}

.stat small {
    color: #737a83;

    font-size: 9px;

    letter-spacing: 1px;

    text-transform: uppercase;
}


/* =========================================================
   SECTION HEADERS
========================================================= */

.section-header {
    max-width: 720px;

    margin: 0 auto 45px;

    text-align: center;
}

.section-header h2 {
    font-size: clamp(36px,5vw,55px);

    line-height: 1;

    margin-bottom: 15px;
}

.section-header h2 span {
    color: var(--blue);
}

.section-header p {
    color: var(--gray);

    line-height: 1.6;
}


/* =========================================================
   SERVICES
========================================================= */

.services {
    background: #05070a;
}

.packages {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 17px;
}

.package {
    position: relative;

    padding: 27px 22px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.045),
            rgba(255,255,255,.008)
        );

    border: 1px solid var(--border);

    border-radius: 15px;

    transition: .3s;
}

.package:hover {
    transform: translateY(-6px);

    border-color:
        rgba(0,140,255,.65);

    box-shadow:
        0 15px 40px rgba(0,0,0,.25);
}

.package.popular {
    border-color: var(--blue);

    box-shadow:
        0 0 35px rgba(0,140,255,.1);
}

.popular-label {
    position: absolute;

    top: 0;
    right: 0;

    padding: 7px 12px;

    background: var(--blue);

    border-radius:
        0 15px 0 10px;

    font-size: 9px;

    font-weight: 900;
}

.package-icon {
    font-size: 30px;

    margin-bottom: 12px;
}

.package h3 {
    font-size: 20px;

    text-transform: uppercase;
}

.package h3 span {
    color: var(--blue);
}

.package.gold h3 span,
.package.gold .price {
    color: var(--gold);
}

.starting {
    color: #777;

    font-size: 10px;

    text-transform: uppercase;

    margin-top: 15px;
}

.price {
    font-size: 43px;

    font-weight: 950;

    margin-bottom: 18px;
}

.features {
    list-style: none;
}

.features li {
    color: #c5c9ce;

    font-size: 12px;

    padding: 7px 0;

    border-bottom:
        1px solid rgba(255,255,255,.04);
}

.features li::before {
    content: "✓";

    color: var(--blue);

    font-weight: 900;

    margin-right: 8px;
}


/* =========================================================
   BEFORE / AFTER GALLERY
========================================================= */

.gallery-section {
    margin-top: 85px;

    padding-top: 70px;

    border-top:
        1px solid rgba(255,255,255,.07);
}

.gallery-header {
    margin-bottom: 35px;
}

.gallery-carousel {
    position: relative;

    display: flex;

    align-items: center;

    gap: 15px;

    max-width: 1050px;

    margin: auto;
}

.gallery-track-wrapper {
    width: 100%;

    overflow: hidden;

    border-radius: 18px;
}

.gallery-track {
    display: flex;

    transition:
        transform .45s cubic-bezier(.2,.8,.2,1);
}

.gallery-slide {
    min-width: 100%;

    padding: 0 2px;
}

.gallery-image-wrap {
    position: relative;

    width: 100%;

    height: 510px;

    overflow: hidden;

    border-radius: 16px;

    background: #080a0d;

    border:
        1px solid rgba(255,255,255,.1);

    box-shadow:
        0 25px 70px rgba(0,0,0,.35);
}

.gallery-image-wrap img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}

.gallery-label {
    position: absolute;

    top: 18px;
    left: 18px;

    padding: 8px 12px;

    background:
        rgba(0,0,0,.78);

    backdrop-filter: blur(10px);

    border:
        1px solid rgba(0,140,255,.5);

    border-radius: 6px;

    color: white;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 2px;
}

.gallery-info {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 25px;

    padding: 20px 5px 5px;
}

.gallery-info > div {
    font-size: 15px;

    font-weight: 900;

    letter-spacing: 1px;
}

.gallery-info > div span {
    color: var(--blue);

    margin-right: 8px;
}

.gallery-info p {
    max-width: 500px;

    color: var(--gray);

    font-size: 13px;

    line-height: 1.5;

    text-align: right;
}

.gallery-arrow {
    flex-shrink: 0;

    width: 48px;
    height: 48px;

    border-radius: 50%;

    border:
        1px solid rgba(255,255,255,.12);

    background:
        rgba(255,255,255,.04);

    color: white;

    font-size: 20px;

    cursor: pointer;

    transition: .25s;

    z-index: 5;
}

.gallery-arrow:hover {
    background: var(--blue);

    border-color: var(--blue);

    box-shadow:
        0 0 25px rgba(0,140,255,.35);

    transform: scale(1.05);
}

.gallery-dots {
    display: flex;

    justify-content: center;

    align-items: center;

    gap: 8px;

    margin-top: 22px;
}

.gallery-dot {
    width: 7px;
    height: 7px;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: #343a40;

    cursor: pointer;

    transition: .25s;
}

.gallery-dot.active {
    width: 24px;

    border-radius: 10px;

    background: var(--blue);

    box-shadow:
        0 0 10px rgba(0,140,255,.4);
}

.gallery-disclaimer {
    margin-top: 18px;

    text-align: center;

    color: #5f666e;

    font-size: 10px;

    letter-spacing: .3px;
}


/* =========================================================
   ADDONS
========================================================= */

.addons-section {
    background: #080b0f;
}

.addons {
    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 14px;
}

.addon {
    padding: 20px;

    background: #0e1217;

    border: 1px solid var(--border);

    border-radius: 10px;

    transition: .25s;
}

.addon:hover {
    transform: translateY(-3px);

    border-color:
        rgba(0,140,255,.45);
}

.addon h4 {
    font-size: 14px;

    margin-bottom: 5px;
}

.addon p {
    color: var(--blue);

    font-weight: 900;
}


/* =========================================================
   BOOKING
========================================================= */

.booking {
    background:
        radial-gradient(
            circle at 15% 40%,
            rgba(0,140,255,.09),
            transparent 30%
        ),
        #05070a;
}

.booking-layout {
    display: grid;

    grid-template-columns:
        .75fr 1.25fr;

    gap: 50px;

    align-items: start;
}

.booking-copy h2 {
    font-size: 48px;

    line-height: 1;

    margin-bottom: 18px;
}

.booking-copy h2 span {
    color: var(--blue);
}

.booking-copy > p {
    color: var(--gray);

    line-height: 1.6;

    margin-bottom: 25px;
}

.contact-box {
    background: #0e1217;

    border: 1px solid var(--border);

    border-radius: 9px;

    padding: 17px;

    margin-bottom: 10px;
}

.contact-box small {
    display: block;

    color: #777;

    text-transform: uppercase;

    font-size: 9px;

    letter-spacing: 1px;

    margin-bottom: 4px;
}

.contact-box strong {
    font-size: 16px;
}

.contact-box a {
    color: white;

    text-decoration: none;
}

.contact-box a:hover {
    color: var(--blue);
}


/* =========================================================
   BOOKING CARD
========================================================= */

.booking-card {
    background: #101419;

    border: 1px solid var(--border);

    border-radius: 16px;

    padding: 28px;

    box-shadow:
        0 20px 60px rgba(0,0,0,.25);
}

.progress {
    display: flex;

    gap: 7px;

    margin-bottom: 28px;
}

.progress span {
    height: 4px;

    flex: 1;

    border-radius: 99px;

    background: #292e34;
}

.progress span.active {
    background: var(--blue);

    box-shadow:
        0 0 10px rgba(0,140,255,.4);
}

.step {
    display: none;
}

.step.active {
    display: block;
}

.step-title {
    font-size: 24px;

    font-weight: 900;
}

.step-subtitle {
    color: #777;

    font-size: 13px;

    margin-bottom: 22px;
}


/* =========================================================
   PACKAGE SELECTION
========================================================= */

.package-select {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 10px;
}

.package-option {
    text-align: left;

    background: #080a0d;

    color: white;

    border: 1px solid #292e34;

    border-radius: 9px;

    padding: 15px;

    cursor: pointer;

    transition: .2s;
}

.package-option:hover {
    border-color:
        rgba(0,140,255,.6);
}

.package-option.selected {
    border-color: var(--blue);

    box-shadow:
        0 0 0 1px var(--blue) inset;
}

.package-option strong {
    display: block;
}

.package-option small {
    color: #888;
}

.package-option b {
    display: block;

    color: var(--blue);

    font-size: 20px;

    margin-top: 4px;
}


/* =========================================================
   FORM
========================================================= */

.form-grid {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 12px;
}

.field {
    margin-bottom: 14px;
}

.field label {
    display: block;

    color: #aaa;

    font-size: 11px;

    margin-bottom: 6px;
}

input,
select,
textarea {
    width: 100%;

    padding: 12px;

    background: #080a0d;

    border: 1px solid #292e34;

    border-radius: 7px;

    color: white;

    outline: none;

    font-family: inherit;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--blue);

    box-shadow:
        0 0 0 2px rgba(0,140,255,.08);
}

textarea {
    min-height: 90px;

    resize: vertical;
}

.step-buttons {
    display: flex;

    justify-content: space-between;

    gap: 10px;

    margin-top: 22px;
}

.summary {
    background: #080a0d;

    border: 1px solid #292e34;

    border-radius: 10px;

    padding: 17px;

    margin-top: 18px;
}

.summary-row {
    display: flex;

    justify-content: space-between;

    gap: 20px;

    padding: 9px 0;

    color: #aaa;

    border-bottom:
        1px solid #191d21;
}

.summary-row:last-child {
    border-bottom: none;
}

.summary-row strong {
    color: white;

    text-align: right;
}


/* =========================================================
   FAQ
========================================================= */

.faq {
    max-width: 800px;

    margin: auto;
}

details {
    border-bottom:
        1px solid var(--border);

    padding: 18px 0;
}

summary {
    cursor: pointer;

    font-weight: 800;
}

details p {
    color: var(--gray);

    padding-top: 10px;

    line-height: 1.6;
}


/* =========================================================
   FOOTER
========================================================= */

footer {
    border-top:
        1px solid var(--border);

    background: #020304;

    padding: 40px 25px;
}

.footer {
    max-width: 1250px;

    margin: auto;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;
}

.footer-logo {
    font-weight: 950;

    font-size: 24px;

    letter-spacing: 4px;
}

.footer-logo span {
    display: block;

    color: var(--blue);

    font-size: 9px;

    letter-spacing: 3px;

    margin-top: 3px;
}

.footer small {
    display: block;

    color: #666;

    margin-top: 7px;
}

.footer-contact {
    color: #aaa;

    font-size: 13px;

    text-align: right;
}

.footer-contact a {
    color: white;

    text-decoration: none;
}

.footer-contact a:hover {
    color: var(--blue);
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1050px) {

    .packages {
        grid-template-columns: 1fr 1fr;
    }

    .addons {
        grid-template-columns: 1fr 1fr;
    }

    .booking-layout {
        grid-template-columns: 1fr;

        gap: 35px;
    }

    .booking-copy {
        max-width: 750px;

        margin: auto;
    }

}


/* =========================================================
   SMALL TABLET
========================================================= */

@media (max-width: 850px) {

    .nav-container {
        padding: 14px 20px;
    }

    .nav-links {
        gap: 15px;
    }

    .nav-links a {
        font-size: 11px;
    }

    .hero {
        padding-left: 25px;
        padding-right: 25px;
    }

    section {
        padding: 75px 22px;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

    html,
    body {
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
    }


    /* MOBILE NAV */

    .nav-container {
        min-height: 65px;

        padding: 10px 16px;
    }

    .logo {
        font-size: 21px;

        letter-spacing: 4px;
    }

    .logo span {
        font-size: 7px;

        letter-spacing: 3px;
    }

    .nav-links {
        display: none;
    }

    .menu-toggle {
        display: flex;
    }


    /* TOP SPACE */

    .top-space {
        height: 65px;
    }


    /* GENERAL */

    section {
        padding: 65px 17px;
    }

    .container {
        width: 100%;
        max-width: 100%;
    }


    /* HERO */

    .hero {
        min-height: auto;

        padding:
            75px 18px 65px;
    }

    .hero::before {
        width: 280px;
        height: 280px;

        right: -180px;
    }

    .eyebrow {
        font-size: 9px;

        letter-spacing: 3px;

        margin-bottom: 15px;
    }

    .hero h1 {
        font-size:
            clamp(43px, 13vw, 60px);

        line-height: .94;

        letter-spacing: -2.5px;
    }

    .hero-description {
        font-size: 15px;

        line-height: 1.55;

        margin-top: 22px;

        margin-bottom: 25px;
    }


    /* HERO BUTTONS */

    .buttons {
        width: 100%;

        flex-direction: column;

        gap: 10px;
    }

    .buttons .btn {
        width: 100%;

        min-height: 50px;
    }


    /* STATS */

    .stats {
        width: 100%;

        display: grid;

        grid-template-columns:
            1fr 1fr;

        gap: 25px 15px;

        margin-top: 35px;
    }

    .stat strong {
        font-size: 21px;
    }

    .stat small {
        font-size: 8px;

        letter-spacing: .8px;
    }


    /* SECTION HEADER */

    .section-header {
        margin-bottom: 32px;
    }

    .section-header h2 {
        font-size:
            clamp(34px, 10vw, 48px);

        line-height: .98;
    }

    .section-header p {
        font-size: 14px;

        line-height: 1.55;
    }


    /* SERVICES */

    .packages {
        grid-template-columns: 1fr;

        gap: 14px;
    }

    .package {
        width: 100%;

        padding: 24px 20px;
    }

    .package:hover {
        transform: none;
    }

    .package h3 {
        font-size: 19px;
    }

    .price {
        font-size: 39px;
    }

    .features li {
        font-size: 12px;

        padding: 8px 0;
    }


    /* =====================================================
       MOBILE GALLERY
    ===================================================== */

    .gallery-section {
        margin-top: 60px;

        padding-top: 55px;
    }

    .gallery-carousel {
        gap: 0;
    }

    .gallery-track-wrapper {
        border-radius: 13px;
    }

    .gallery-image-wrap {
        height: 390px;

        border-radius: 13px;
    }

    .gallery-arrow {
        display: none;
    }

    .gallery-info {
        display: block;

        padding:
            16px 3px 0;
    }

    .gallery-info > div {
        font-size: 13px;

        margin-bottom: 8px;
    }

    .gallery-info p {
        text-align: left;

        font-size: 12px;

        line-height: 1.5;
    }

    .gallery-label {
        top: 12px;
        left: 12px;

        font-size: 8px;

        padding: 7px 9px;
    }

    .gallery-dots {
        margin-top: 17px;
    }

    .gallery-disclaimer {
        font-size: 9px;

        line-height: 1.5;

        max-width: 300px;

        margin-left: auto;
        margin-right: auto;
    }


    /* ADDONS */

    .addons {
        grid-template-columns: 1fr;

        gap: 10px;
    }

    .addon {
        padding: 17px;
    }

    .addon:hover {
        transform: none;
    }

    .addon h4 {
        font-size: 13px;
    }


    /* BOOKING */

    .booking-layout {
        display: flex;

        flex-direction: column;

        width: 100%;

        gap: 30px;
    }

    .booking-copy {
        width: 100%;
    }

    .booking-copy h2 {
        font-size:
            clamp(35px, 10vw, 45px);

        line-height: .98;
    }

    .booking-copy > p {
        font-size: 14px;
    }

    .contact-box {
        padding: 15px;
    }

    .contact-box strong {
        font-size: 14px;

        line-height: 1.5;
    }


    /* BOOKING CARD */

    .booking-card {
        width: 100%;

        padding: 18px 15px;

        border-radius: 13px;
    }

    .step-title {
        font-size: 21px;
    }

    .step-subtitle {
        font-size: 12px;

        line-height: 1.4;
    }


    /* BOOKING PACKAGE OPTIONS */

    .package-select {
        grid-template-columns: 1fr;

        gap: 9px;
    }

    .package-option {
        width: 100%;

        min-height: 82px;

        padding: 14px;
    }

    .package-option b {
        font-size: 18px;
    }


    /* FORMS */

    .form-grid {
        grid-template-columns: 1fr;

        gap: 0;
    }

    .field {
        margin-bottom: 13px;
    }

    .field label {
        font-size: 10px;
    }

    input,
    select,
    textarea {
        width: 100%;

        min-height: 46px;

        padding: 12px;

        font-size: 16px;

        border-radius: 7px;
    }

    textarea {
        min-height: 100px;
    }


    /* BOOKING BUTTONS */

    .step-buttons {
        flex-direction: column-reverse;

        gap: 9px;

        width: 100%;

        margin-top: 20px;
    }

    .step-buttons span {
        display: none;
    }

    .step-buttons .btn {
        width: 100%;

        min-height: 48px;
    }


    /* SUMMARY */

    .summary {
        padding: 13px;
    }

    .summary-row {
        display: grid;

        grid-template-columns:
            1fr auto;

        gap: 12px;

        font-size: 12px;
    }

    .summary-row strong {
        max-width: 180px;

        overflow-wrap: anywhere;
    }


    /* FAQ */

    .faq {
        width: 100%;
    }

    details {
        padding: 17px 0;
    }

    summary {
        font-size: 14px;

        line-height: 1.4;
    }

    details p {
        font-size: 13px;

        line-height: 1.55;
    }


    /* FOOTER */

    footer {
        padding: 35px 18px;
    }

    .footer {
        width: 100%;

        flex-direction: column;

        gap: 22px;

        text-align: center;
    }

    .footer-contact {
        text-align: center;

        font-size: 12px;

        line-height: 1.7;
    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .hero h1 {
        font-size: 42px;
    }

    .hero-description {
        font-size: 14px;
    }

    .stats {
        gap: 20px 10px;
    }

    .stat strong {
        font-size: 19px;
    }

    .section-header h2 {
        font-size: 34px;
    }

    .booking-card {
        padding: 15px 12px;
    }

    .gallery-image-wrap {
        height: 340px;
    }

}

</style>

</head>


